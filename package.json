{
  "name": "aitp-atlas",
  "version": "0.11.0",
  "description": "AITP Atlas for DeepSeek Harness: draft physics questions at the Desk, explore a map of research notes, and read papers, discuss passages and edit LaTeX in two panes. Review observed changes against saved note baselines.",
  "type": "module",
  "license": "MIT",
  "author": "Bohan Jia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhjia-phys/aitp-atlas.git"
  },
  "homepage": "https://github.com/bhjia-phys/aitp-atlas#readme",
  "bugs": {
    "url": "https://github.com/bhjia-phys/aitp-atlas/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aitp",
    "research",
    "physics"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "templates/team/",
    "client.js",
    "vendor/pdfjs/*",
    "vendor/fonts/*",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "scripts/install-dsh.mjs",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:team": "node scripts/preview.mjs --team",
    "install:dsh": "node scripts/install-dsh.mjs",
    "prepack": "node build-client.mjs --check",
    "test": "node build-client.mjs --check && node --test \"test/*.test.mjs\"",
    "test:dsh": "node test/dsh-e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": "^0.2.2-rc.1"
    }
  }
}
